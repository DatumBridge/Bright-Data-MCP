BRIGHTDATA_MCP_PORT=8011
LOG_LEVEL=INFO

# Bright Data API (local/dev fallback when credentials_json not provided)
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_BROWSER_ZONE=

# Tool visibility (mirrors official @brightdata/mcp)
# Rapid (default): search_engine, scrape_as_markdown, search_engine_batch, scrape_batch + legacy aliases
# discover removed (Bright Data Discover API HTTP 410)
BRIGHTDATA_PRO_MODE=false
# BRIGHTDATA_GROUPS=ecommerce,social,browser
# BRIGHTDATA_TOOLS=search_engine,web_data_amazon_product

# Optional
# BRIGHTDATA_API_URL=https://api.brightdata.com/request
# BRIGHTDATA_HTTP_TIMEOUT_SEC=90
# BRIGHTDATA_POLLING_TIMEOUT_SEC=120
# BRIGHTDATA_MAX_CHARS=100000
# BRIGHTDATA_CREDENTIALS_DIR=/credentials
# BRIGHTDATA_MCP_ALLOWED_ORIGINS=http://localhost:5173
